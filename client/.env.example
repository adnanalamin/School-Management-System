# Copy to `.env.local`. Only variables prefixed with VITE_ are exposed to the browser,
# so NEVER put secrets here: everything in a Vite client bundle is public.

# Base URL of the API. Keep the default in development (Vite proxies /api to the server).
# In production set this to the public API URL if it is not served from the same origin.
VITE_API_BASE_URL=/api/v1

# Display name used in the UI and page titles.
VITE_APP_NAME=School Management System

# Dev only: where the Vite dev server proxies /api requests.
VITE_DEV_API_PROXY_TARGET=http://localhost:5000
