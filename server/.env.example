# Copy to `.env` and adjust. Never commit `.env`.

NODE_ENV=development
PORT=5000

# Local development database (see docker-compose.yml at the repo root). It runs as a single-node replica set
# because transactions (payments, book loans) require one; `directConnection=true` is needed for that local setup only.
# For MongoDB Atlas or any authenticated server, put the full connection string
# (including credentials) ONLY in your untracked .env or your host's secret store.
MONGODB_URI=mongodb://127.0.0.1:27017/school_management?directConnection=true

# Comma-separated list of browser origins allowed to call this API (CORS).
CLIENT_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Number of reverse-proxy hops in front of the API (0 = none). Set this correctly
# in production so rate limiting sees the real client IP.
TRUST_PROXY=0

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Reserved for Phase 2 (authentication). Not read yet. Generate long random values:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
